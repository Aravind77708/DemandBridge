# Backend: put the Neon pooled PostgreSQL connection string in DATABASE_URL.
# Keep the real value in a local .env file and Render's environment settings only.
DATABASE_URL=

# Backend: exact Vercel production origin and any custom frontend domain.
CORS_ORIGINS=https://your-project.vercel.app

# Frontend build: API origin, with no trailing slash or /api suffix.
# On Vercel set this to the Render backend URL, e.g. https://demandbridge-api.onrender.com
API_BASE_URL=

# Render supplies PORT automatically. Local Node server default is 4173.
PORT=4173

# Optional: keep PostgreSQL client connections within the Neon plan limits.
PG_POOL_MAX=5

# Required by the Node API. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep private in local .env and Render only; never set this in Vercel.
AUTH_TOKEN_SECRET=

# Local-only option for password-protected demo accounts. Never enable in production.
DEMO_AUTH_ENABLED=false
