# Leave blank when frontend and API are served by the same Render web service.
API_BASE_URL=

# Comma-separated exact origins permitted to call this API.
# Include the deployed frontend origin only if hosted on a separate domain.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Optional; Render sets PORT automatically. DATA_FILE can point to a mounted disk.
PORT=4173
DATA_FILE=./data.json
